#!/usr/bin/env bash
#
# Deploy a stack to a new image version, from here, over SSH.
#
#   scripts/deploy brittico-site 1.2.0    bump and roll out
#   scripts/deploy brittico-site          just print what is running
#   scripts/deploy                        list every stack and its version
#
# The four stacks all update the same way: edit one `*_VERSION` in the stack's
# .env, pull, up. That is short enough to do by hand and just long enough to get
# wrong at the wrong moment — usually by pulling a tag the Action has not
# published yet, which leaves the .env already edited and the stack refusing to
# start.
#
# So the order here is deliberate: verify the tag exists on the registry FIRST,
# and only then touch anything.
#
# Default host works with no ~/.ssh/config; override with NAS_HOST=user@host.

set -euo pipefail

NAS="${NAS_HOST:-truenas_admin@192.168.0.82}"
REMOTE_PATH=/tmp/.homelab-deploy.sh

usage() {
  sed -n '3,7p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

case "${1:-}" in -h|--help) usage 0 ;; esac

remote_script() { sed -n '/^# ---8<--- REMOTE/,/^# ---8<--- END/p' "$0"; }
args="$(printf '%q ' "${1:-}" "${2:-}")"

# The remote half needs root: /mnt/StorageHD1/stacks cannot be entered as
# truenas_admin, so even the read-only listing fails without it.
#
# Log in as root and there is no sudo, no password, and therefore no terminal
# needed — one connection, script on stdin, works from anywhere including a
# cron job. That path is not available by default: root has no authorized key
# on this NAS. Install one and `NAS_HOST=root@192.168.0.82` takes it.
case "${NAS_SUDO:-auto}" in
  0)    SUDO="" ;;
  auto) case "$NAS" in root@*) SUDO="" ;; *) SUDO="sudo" ;; esac ;;
  *)    SUDO="sudo" ;;
esac

if [ -z "$SUDO" ]; then
  remote_script | ssh "$NAS" bash -s -- "${1:-}" "${2:-}"
  exit $?
fi

# sudo asks for a password, and a password needs a TTY to be typed into. Fail
# here with a reason rather than letting sudo emit "a terminal is required" —
# which arrives on stderr, often swallowed, and reads like the script did
# nothing at all.
if [ ! -t 0 ] || [ ! -t 1 ]; then
  cat >&2 <<MSG
scripts/deploy needs a real terminal.

Logging in as $NAS means sudo on the NAS, and sudo asks for a password that
has to be typed somewhere. There is no terminal here — you are piping it,
running it from a tool, or from a job.

Open a terminal and run it there. To make it work without one, give root an
authorized key on the NAS and use:

    NAS_HOST=root@192.168.0.82 scripts/deploy ${1:-}${2:+ $2}
MSG
  exit 1
fi

# Two connections, deliberately: sudo needs the terminal free to prompt, and
# with the script arriving on stdin there would be no free channel for it. So
# upload first, then run it with -t.
remote_script | ssh "$NAS" "cat > $REMOTE_PATH"
ssh -t "$NAS" "$SUDO bash $REMOTE_PATH $args; rc=\$?; rm -f $REMOTE_PATH; exit \$rc"
exit $?

# ---8<--- REMOTE
set -euo pipefail

STACKS=/mnt/StorageHD1/stacks
stack="${1:-}"
version="${2:-}"

# The variable is not hardcoded per stack: each .env holds exactly one
# `*_VERSION` (SITE_VERSION, BOT_VERSION, BACKEND_VERSION, CLOUDFLARED_VERSION),
# so reading it is more honest than a lookup table that can drift.
version_var() { grep -oE '^[A-Z_]+VERSION=' "$1/.env" 2>/dev/null | head -1 | tr -d '='; }

# --- no arguments: show what is running everywhere ---------------------------
if [ -z "$stack" ]; then
  printf '%-22s %-18s %s\n' STACK VERSION STATUS
  for dir in "$STACKS"/*/; do
    name="$(basename "$dir")"
    var="$(version_var "$dir")" || true
    if [ -z "${var:-}" ]; then
      printf '%-22s %-18s %s\n' "$name" "-" "not managed here"
      continue
    fi
    cur="$(grep "^$var=" "$dir/.env" | cut -d= -f2-)"
    st="$(docker ps --filter "label=com.docker.compose.project=$name" \
          --format '{{.Status}}' | head -1)"
    printf '%-22s %-18s %s\n' "$name" "$var=$cur" "${st:-down}"
  done
  exit 0
fi

dir="$STACKS/$stack"
[ -d "$dir" ] || { echo "no such stack: $dir" >&2; exit 1; }
cd "$dir"
[ -f .env ] || { echo "no .env in $dir — nothing to bump" >&2; exit 1; }

var="$(version_var "$dir")"
[ -n "$var" ] || { echo "no *_VERSION variable in $dir/.env" >&2; exit 1; }
current="$(grep "^$var=" .env | cut -d= -f2-)"

# --- one argument: report and stop -------------------------------------------
if [ -z "$version" ]; then
  echo "$stack: $var=$current"
  docker compose ps
  exit 0
fi

# The .env saying $version does not mean the stack is RUNNING $version: a
# roll-out that dies between the edit and `up` (a tag the Action had not
# finished pushing, a pull that failed) leaves exactly that state — and the
# obvious fix, running the same command again, used to answer "nothing to do"
# and leave the stack on the old image with a .env that lies about it.
#
# So the early exit moves down, after the registry check, and only fires when
# what is running matches what the .env asks for.
# An `if` and not `[ ... ] && resume=1`: with `set -e`, a one-liner whose test
# fails is a failing statement, and the script would exit right here on the
# normal path — the version being different is the common case.
resume=0
if [ "$version" = "$current" ]; then resume=1; fi

# --- verify the tags exist BEFORE editing anything ---------------------------
# Compose reads shell environment ahead of the .env file, so this resolves the
# images the new version *would* use without writing the change first.
#
# EVERY image, and not just the first one. A stack can pin more than one to the
# same variable — britticobot pins the bot and the voice — and the Action pushes
# them one after another, so there is a window of a minute or two where the
# first tag exists and the second does not. Checking only the first walked
# straight into that window: .env edited, `pull` failed on the second image,
# stack still on the old version and the script already gone.
images="$(env "$var=$version" docker compose config --images 2>/dev/null)"
if [ -z "$images" ]; then
  # Older compose has no --images. Reading the resolved config is slower but
  # works everywhere, and this runs before anything has been modified.
  images="$(env "$var=$version" docker compose config \
            | awk '$1=="image:"{print $2}')"
fi
[ -n "$images" ] || { echo "could not work out the images for $stack" >&2; exit 1; }

for image in $images; do
  echo "checking $image ..."
  docker manifest inspect "$image" >/dev/null 2>&1 && continue
  echo >&2
  echo "not on the registry: $image" >&2
  echo "the build probably has not finished, or the tag is a typo." >&2
  echo "nothing was changed." >&2
  exit 1
done

# --- already there? only if it is also what is running -----------------------
if [ "$resume" = 1 ]; then
  running="$(docker compose ps -q 2>/dev/null \
             | xargs -r docker inspect -f '{{.Config.Image}}' 2>/dev/null | sort -u)"
  missing=""
  for image in $images; do
    printf '%s\n' "$running" | grep -qxF "$image" || missing="$missing $image"
  done
  if [ -z "$missing" ]; then
    echo "$stack is already on $version, and running it — nothing to do."
    exit 0
  fi
  echo "$stack: .env already says $version, but that is not what is running."
  echo "finishing the roll-out:$missing"
fi

# --- roll it out --------------------------------------------------------------
if [ "$resume" = 0 ]; then
  echo "$stack: $current -> $version"
  cp .env .env.bak                    # what a rollback restores
  sed -i "s|^$var=.*|$var=$version|" .env

  if ! docker compose config >/dev/null; then
    echo "compose no longer resolves — restoring .env" >&2
    mv .env.bak .env
    exit 1
  fi
fi

docker compose pull
docker compose up -d

# --- wait for the healthcheck to settle ---------------------------------------
# `up -d` returns as soon as the container is started, which is well before it
# is serving. Without this wait the script would report success on a container
# that is about to crash-loop.
cid="$(docker compose ps -q | head -1)"
status=none
for _ in $(seq 1 30); do
  status="$(docker inspect -f \
    '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$cid" 2>/dev/null || echo gone)"
  case "$status" in healthy|none|gone) break ;; esac
  sleep 2
done

echo
case "$status" in
  healthy)
    echo "$stack is healthy on $version."
    ;;
  none)
    echo "$stack is up on $version. No healthcheck defined, so that is all this can say."
    ;;
  *)
    echo "$stack came up $status on $version." >&2
    echo >&2
    docker compose logs --tail 30 >&2
    echo >&2
    echo "to go back, on the NAS:" >&2
    echo "  cd $dir && mv .env.bak .env && docker compose up -d" >&2
    echo "or from your machine: scripts/deploy $stack $current" >&2
    exit 1
    ;;
esac

# ---8<--- END
