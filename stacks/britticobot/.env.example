# britticobot — copy to `.env` and fill in. The `.env` never enters git.
#
# The code reads 49 environment variables; the previous compose file defined 24.
# The other 25 were running on silent defaults, and some of them switch off a
# whole feature without telling anyone. Those are tagged [WAS DEFAULTING] below.
# Go through them once: from here on it is a choice, not an accident.

# ===== Deployment =====
# Image tag. Never `latest` — this is what lets you tell which build is running
# and roll back. The workflow publishes <version>, sha-<commit> and latest.
BOT_VERSION=1.2.0
# Host port. Inside the container it always listens on 3000.
BOT_PORT=3000
# Database + feed images + avatars + shop images. This is what backups cover.
# NOTE: with WAL enabled there are also -wal and -shm files next to the .db.
# Copying only the .db captures an incomplete snapshot — use `sqlite3 .backup`.
BOT_DATA_HOST_PATH=/mnt/StorageHD1/configs/brittico_bot/db

# ===== API =====
# Bearer token for the private routes. Today this is the SAME value as
# ANALYTICS_API_KEY in the site's api/analytics/_config.php — once analytics
# moves into its own service (brittinho-backend), each side gets its own.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_SECRET_KEY=

# ===== Twitch bot =====
TWITCH_BOT_USERNAME=brittico
TWITCH_CHANNEL=kennzy
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_OAUTH_TOKEN=oauth:
# [WAS DEFAULTING] Token carrying the clips:edit scope, for !clip. The chat
# token above does NOT work (it only has chat:read/chat:edit). Empty means
# !clip silently fails to create a clip.
TWITCH_CLIP_OAUTH_TOKEN=
# [WAS DEFAULTING] Pins the channel's numeric id, skipping the lookup call.
TWITCH_BROADCASTER_ID=

# ===== Kick bot =====
KICK_CHANNEL=kennzy
KICK_CHATROOM_ID=
KICK_BROADCASTER_ID=
KICK_BOT_USERNAME=britticobot
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REFRESH_TOKEN=

# ===== Bolotas game =====
# Who may start/stop a round with !bolotas, on both platforms. Lowercase,
# comma separated. Twitch mods and the broadcaster are already allowed.
GAME_MODERATORS=

# ===== !song command (Last.fm) =====
# [WAS DEFAULTING] Without the key, !song does not answer. https://www.last.fm/api
LASTFM_API_KEY=
# [WAS DEFAULTING]
LASTFM_USER=

# ===== Site login for /kennzy/ (a Twitch app SEPARATE from the bot) =====
AUTH_TWITCH_CLIENT_ID=
AUTH_TWITCH_CLIENT_SECRET=
AUTH_TWITCH_REDIRECT_URI=https://brittinho.com/kennzy/
# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Exact site origin, for CORS with credentials. No trailing slash.
SITE_ORIGIN=https://brittinho.com
# Moderators by numeric Twitch id (helix/users?login=someone -> "id").
MODERATORS=
SESSION_DAYS=90

# [WAS DEFAULTING] Kick and Google login on the site. Empty means Twitch only.
# When the redirect URIs are blank they fall back to AUTH_TWITCH_REDIRECT_URI.
AUTH_KICK_CLIENT_ID=
AUTH_KICK_CLIENT_SECRET=
AUTH_KICK_REDIRECT_URI=
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URI=

# ===== Camzy — subscriber webcam rooms (/kennzy/cam/) =====
# [WAS DEFAULTING] false means the page shows "coming soon" and the WebSocket
# refuses connections.
CAM_ENABLED=false
# Numeric Twitch ids that join as HOST. Comma separated.
CAM_HOST_IDS=
CAM_HOST_NAME=Kennzy
# true (the default) forces all video through the TURN relay, so no participant
# ever sees another's IP address. Requires a TURN server configured below.
CAM_FORCE_RELAY=true
# Option A (recommended): Cloudflare Realtime TURN, 1 TB/month free.
CAM_CF_TURN_KEY_ID=
CAM_CF_TURN_KEY_TOKEN=
# Option B: your own coturn.
CAM_TURN_URLS=
CAM_TURN_STATIC_SECRET=
CAM_TURN_USERNAME=
CAM_TURN_PASSWORD=
# Dev/testing only: allows direct connections with NO TURN (IPs become visible).
CAM_ALLOW_DIRECT=false
CAM_STUN_URLS=stun:stun.cloudflare.com:3478

# ===== Multiplayer island (/kennzy/ilha/) =====
# [WAS DEFAULTING]
ILHA_ENABLED=false

# ===== OBS remote control (/kennzy/diretor/) =====
# [WAS DEFAULTING]
OBS_REMOTE_ENABLED=false

# ===== Telegram alerts (analytics) =====
# [WAS DEFAULTING] Without both, the watchlist alert is never delivered.
# NOTE: both move out of here once analytics becomes brittinho-backend.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
