# tia-dash: copy to `.env` on the NAS and fill in. The `.env` never enters git.

# Image tag. Never `latest`. scripts/deploy.sh rewrites this line.
TIA_DASH_VERSION=0.1.0

# Where the SQLite database lives. It is the only state; Litestream replicates it to R2.
# The directory must belong to uid 1000 (the `node` user in the image): scripts/deploy.sh does it.
TIA_DASH_DATA_HOST_PATH=/mnt/StorageHD1/configs/tia_dash/data

# ===== Login (Cloudflare Access) =====
# Zero Trust > Settings > Custom Pages: the team domain, "<name>.cloudflareaccess.com".
CF_ACCESS_TEAM_DOMAIN=
# Zero Trust > Access > Applications > this app > Overview: "Application Audience (AUD) Tag".
CF_ACCESS_AUD=
# Comma separated. A second lock on top of the Access policy: only these emails get in.
ADMIN_EMAILS=

# ===== Backup (Litestream -> Cloudflare R2) =====
# An R2 API token scoped to ONE bucket (Object Read & Write), same shape as the overlay reserve's.
# The bucket is created by hand: a scoped token cannot create buckets.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
