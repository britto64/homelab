# Pinned tags, never `latest` — same rule as every stack here.
# LiveKit server: https://github.com/livekit/livekit/releases (checked 2026-10-03: v1.13.7).
# Update procedure in docs/runbooks/livekit-on-the-vps.md.
LIVEKIT_VERSION=v1.13.7
# LiveKit's own Caddy build with the layer4 plugin (the stock Caddy image cannot route TURN/TLS
# and HTTPS on the same :443).
CADDY_L4_VERSION=v2.11.3

# `tls` = run Caddy next to LiveKit (the VPS). Empty = LiveKit only (the NAS variant, where the
# Cloudflare tunnel carries the signalling and no certificate lives here).
COMPOSE_PROFILES=tls

# The two hostnames. Both must be A records pointing at the VPS in Cloudflare with the proxy OFF
# (grey cloud, "DNS only"): media is UDP, and the orange cloud only passes HTTP(S).
#   livekit.<domain>  the SDK endpoint: wss://livekit.<domain> and the admin REST API
#   turn.<domain>     the built-in TURN over TLS on :443, the way out for restrictive networks
LIVEKIT_DOMAIN=livekit.brittico.xyz
TURN_DOMAIN=turn.brittico.xyz

# The API key pair. The bot uses it to mint tokens, call the admin API and (the same key) verify the
# webhook signature. Generate with ./gen-keys.sh. Alphanumeric only — the config is rendered with
# sed, which does not escape metacharacters — and the secret must be 32+ characters (the server
# logs an error below that). Rotate by generating a new pair here and in the bot's .env.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Where LiveKit posts room events (participant_joined/left, track_published...). The bot verifies
# the signature with the same key pair. If the bot is down, LiveKit retries and then drops the
# event: the bot reconciles with ListParticipants when it comes back (see the runbook).
LIVEKIT_WEBHOOK_URL=https://api.brittico.xyz/api/diskenzy/v2/rtc/webhook

# The public IPv4 of this machine. On the VPS leave it EMPTY: LiveKit discovers it by STUN
# (use_external_ip). Fill it only if STUN is blocked or the machine has several addresses, or on the
# NAS variant, where it is the house's public IP (and has to be re-rendered when the ISP changes it).
LIVEKIT_NODE_IP=

# Where the signalling/admin port (7880) listens. 127.0.0.1 behind Caddy on the VPS. On the NAS
# variant the tunnel container reaches it over the LAN, so use 0.0.0.0 there (the NAS firewall
# keeps 7880 inside the house).
LIVEKIT_HTTP_BIND=127.0.0.1
