# cloudflared — copy to `.env` and fill in. The `.env` never enters git.

# Image version. Pinned instead of `latest` for the same reason as every other
# stack here: knowing what is running, and being able to go back. The
# `--no-autoupdate` flag already stops the agent updating itself from within.
CLOUDFLARED_VERSION=2026.7.0

# Tunnel token (Zero Trust > Networks > Tunnels > your tunnel > Install).
# Treat it as a credential: whoever holds it can publish anything under your
# domain. It sat in plain text inside the old compose body, so if that file was
# ever shared, rotate the tunnel before bringing this up.
TUNNEL_TOKEN=
