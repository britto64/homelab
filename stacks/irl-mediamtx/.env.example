# Pinned tag, never `latest` — same rule as every stack here.
IRL_MEDIAMTX_VERSION=1.12.0

# The credentials that travel inside the SRT streamid (and in the HLS URL).
# Long and random — this is the key to going live. Alphanumeric only: the
# config is rendered with sed, which does not escape metacharacters. Rotate
# here and in the Larix link whenever it may have leaked.
IRL_SRT_USER=kennzy
IRL_SRT_PASSWORD=

# The credentials the bot uses to read the control API (GET /v3/paths).
# A different pair on purpose: the API lets you inspect and drop paths, so
# it never shares a secret with the phone's streamid.
IRL_API_USER=britto
IRL_API_PASSWORD=
