# britticobot — copy to `.env` and fill in. The `.env` never enters git.
#
# The code reads 61 environment variables; the live compose defines 30. The rest
# run on defaults — and the default is not always `off`, so read the comments
# before filling anything in with `false`.
#
# API_SECRET_KEY and the TELEGRAM_* pair are gone: they belonged to the
# analytics, which is now stacks/brittinho-backend/.

# ===== Deployment =====
# Image tag. Never `latest` — this is what lets you tell which build is running
# and roll back. The workflow publishes <version>, sha-<commit> and latest.
BOT_VERSION=1.2.0
# Database + feed images + avatars + shop images. This is what backups cover.
# NOTE: with WAL enabled there are also -wal and -shm files next to the .db.
# Copying only the .db captures an incomplete snapshot — use `sqlite3 .backup`.
BOT_DATA_HOST_PATH=/mnt/StorageHD1/configs/brittico_bot/db

# ===== The alerts' voice (the `piper` service) =====
# There is NO PIPER_VERSION on purpose: the voice image is published under the
# bot's version and pinned to ${BOT_VERSION}, so the two roll together.
# `scripts/deploy` bumps only the first *_VERSION it finds — a second one here
# would never be touched. See the comment in compose.yaml.
#
# The voice models, ~63 mb each. NOT part of the backup: they are downloaded
# again on first boot if the directory is empty. Losing it costs a slow start.
PIPER_DATA_HOST_PATH=/mnt/StorageHD1/configs/brittico_bot/vozes
# Which models to download, comma separated. These four are every Brazilian
# Portuguese voice Piper has (~250 mb together). Dropping one from the list does
# not delete it from the volume — it just stops being offered in the editor.
PIPER_VOICES=pt_BR-faber-medium,pt_BR-cadu-medium,pt_BR-jeff-medium,pt_BR-edresson-low
# Loaded at startup, and what answers when an overlay names no voice. The others
# are loaded into memory by the first alert that uses them.
PIPER_DEFAULT_VOICE=pt_BR-faber-medium

# ===== Twitch bot =====
TWITCH_BOT_USERNAME=brittico
TWITCH_CHANNEL=kennzy
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_OAUTH_TOKEN=oauth:
# Not set in production. Token carrying the clips:edit scope, for !clip. The chat
# token above does NOT work (it only has chat:read/chat:edit). Empty means
# !clip silently fails to create a clip.
TWITCH_CLIP_OAUTH_TOKEN=
# The channel's numeric id (helix/users?login=kennzy -> "id"). It started as an
# optional shortcut that skipped one lookup, and now has a second job: it is the
# gate on /conexoes/, the page where the channel's platform accounts are
# authorised. Empty means that page opens for nobody — a gate that does not know
# who the owner is is not a gate. See the Channel connections section below.
TWITCH_BROADCASTER_ID=51633358

# ===== Kick bot =====
KICK_CHANNEL=kennzy
KICK_CHATROOM_ID=
KICK_BROADCASTER_ID=
KICK_BOT_USERNAME=britticobot
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REFRESH_TOKEN=

# ===== Bolotas game =====
# Who may start/stop a round with !bolotas, on both platforms. Lowercase,
# comma separated. Twitch mods and the broadcaster are already allowed.
GAME_MODERATORS=

# ===== Music: !song and the /musica/ page (Last.fm) =====
# Set in production — !song works. https://www.last.fm/api
#
# The same key now feeds /musica/: the bot copies the listening history into
# the database, counts who asked what with !song, and builds the Spotify
# playlists out of it. Without this key the whole music area is off — !song
# answers its friendly error and nothing is collected.
LASTFM_API_KEY=
LASTFM_USER=
# Optional, with sane defaults. How often the history is read (min 20s),
# how many pages of 200 plays the backfill pulls PER BOOT while walking
# backwards (each boot resumes where the last one stopped; 0 disables it), and
# the timezone "this week" and "this month" are counted in. The container runs
# in UTC, and without the last one the week would start at 21:00 on Sunday —
# three hours of Sunday-night music landing in the following week.
MUSIC_POLL_SECONDS=60
MUSIC_BACKFILL_PAGES=30
MUSIC_TZ=America/Sao_Paulo
# Market for Spotify searches: a track unavailable in Brazil is no use in the
# playlist.
SPOTIFY_MARKET=BR

# ===== Site login for /kennzy/ (a Twitch app SEPARATE from the bot) =====
AUTH_TWITCH_CLIENT_ID=
AUTH_TWITCH_CLIENT_SECRET=
AUTH_TWITCH_REDIRECT_URI=https://brittinho.com/kennzy/
# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Exact site origin, for CORS with credentials. No trailing slash.
SITE_ORIGIN=https://brittinho.com
# Moderators by numeric Twitch id (helix/users?login=someone -> "id").
MODERATORS=
SESSION_DAYS=90

# Not set in production. Kick and Google login on the site. Empty means Twitch only.
# When the redirect URIs are blank they fall back to AUTH_TWITCH_REDIRECT_URI.
AUTH_KICK_CLIENT_ID=
AUTH_KICK_CLIENT_SECRET=
AUTH_KICK_REDIRECT_URI=
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URI=

# ===== Camzy — subscriber webcam rooms (/kennzy/cam/) =====
# Defaults to false in code, but production sets it true — Camzy is live.
CAM_ENABLED=true
# Numeric Twitch ids that join as HOST. Comma separated.
CAM_HOST_IDS=
CAM_HOST_NAME=Kennzy
# true (the default) forces all video through the TURN relay, so no participant
# ever sees another's IP address. Requires a TURN server configured below.
CAM_FORCE_RELAY=true
# Option A (recommended): Cloudflare Realtime TURN, 1 TB/month free.
CAM_CF_TURN_KEY_ID=
CAM_CF_TURN_KEY_TOKEN=
# Option B: your own coturn.
CAM_TURN_URLS=
CAM_TURN_STATIC_SECRET=
CAM_TURN_USERNAME=
CAM_TURN_PASSWORD=
# Dev/testing only: allows direct connections with NO TURN (IPs become visible).
#
# ⚠️ Production currently has this `true`, which quietly defeats
# CAM_FORCE_RELAY. The fallback chain in ice.ts is: Cloudflare TURN -> coturn ->
# direct. If the Cloudflare TURN call fails — expired token, rate limit, a
# network blip — the code logs a warning and falls through to the direct branch,
# returning `ipProtected: false`. Participants then see each other's addresses.
#
# With this at `false` the same failure returns no ICE servers at all: the call
# simply does not connect. That fails closed, which is the behaviour you want
# from a setting whose whole purpose is hiding people's addresses.
CAM_ALLOW_DIRECT=false
CAM_STUN_URLS=stun:stun.cloudflare.com:3478

# ===== Multiplayer island (/kennzy/ilha/) =====
# Defaults to TRUE in code (island.ts). Never set in the old compose, so the
# island has been live all along — writing `false` here switches it off.
ILHA_ENABLED=true

# ===== OBS remote control (/kennzy/diretor/) =====
# Also defaults to TRUE in code (obs-remote.ts). Same warning.
OBS_REMOTE_ENABLED=true

# ===== Kennzy Custom Feed ("Novo" Column) and the LoL hub =====
# Feeds both the home page's timeline and brittico.xyz/lol/.
#
# Get a Personal Product key at https://developer.riotgames.com/. The code
# assumes that key's limits — 20 requests/second and 100 per 2 minutes — and
# every Riot call in the bot shares one limiter sized for them, so the poller,
# the nightly job and the backfill script cannot add up to a 429 between them.
# Without the key nothing breaks; the hub simply stops updating.
RIOT_API_KEY=
# Tracked accounts, comma-separated, as gameName#tagLine:Label. The label is
# what the site shows. Empty falls back to kennzy#knnzy and bugino#br1.
LOL_ACCOUNTS=kennzy#knnzy:Kennzy,bugino#br1:Bugino
LOL_PLATFORM=br1
LOL_REGION=americas
# Season start (YYYY-MM-DD). Bounds everything the hub reports — stats, builds,
# the elo chart, and which videos may be linked to a champion. Empty means
# January 1st of the current year. See docs/runbooks/lol-backfill.md.
LOL_SEASON_START=
# Used to fetch new video uploads for the timeline and to link videos to the
# champion they are about.
# Generate via Google Cloud Console (YouTube Data API v3).
YOUTUBE_API_KEY=
# Comma-separated list of YouTube Channel IDs to track.
# You can find a channel ID at https://www.youtube.com/account_advanced
YOUTUBE_CHANNEL_IDS=

# ===== Channel connections (brittico.xyz/conexoes/) =====
# The Twitch, Kick and YouTube accounts KENNZY authorises so the bot can
# subscribe to the events that fire the overlay alerts. Not the same thing as
# the site login above: that answers "who are you" for any visitor and leaves a
# 90-day cookie; this grants scopes on one account and leaves a refresh token
# that has to survive for months.
#
# Twitch and Kick each need an app of their own here, and neither is thrift.
#
# EventSub's rule is that the app receiving the authorisation must be the app
# creating the subscriptions — it checks the channel granted the scope to THAT
# client id. That is not the same as "must be the bot's app", which is how this
# started: the production TWITCH_CLIENT_ID belongs to an app on another Twitch
# account, with no way to register the return address, and the symptom was a
# redirect_mismatch delivered to a forgotten localhost:3000. Whichever app goes
# here, EventSub will have to use the same one.
#
# Kick needs a separate app for a different reason, and that one was not a choice:
# Kick stores one redirect_uri per app and will not let an existing one be
# edited, and the bot's app holds the http://localhost:3000 that
# kick-auth-helper uses. The new app wants the events:subscribe scope and the
# API callback registered. It deliberately does NOT inherit KICK_CLIENT_ID —
# the bot's app is configured, so a fallback would make the card offer
# "connect" and land on a redirect error from Kick.
#
# Encrypts the tokens stored in the database. The database goes wherever backups
# go; the .env stays here. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it invalidates every connection — all three have to be reconnected.
GRANTS_KEY=
# Where the platform sends the browser back. The API, not the site: the code is
# exchanged server-side and never reaches the browser. No trailing slash. Each
# platform gets /api/connect/<platform>/callback, and the address registered in
# its console must match character for character — the page itself shows all
# three, read from the server, ready to copy.
#
# Host only: https, no path, and it inherits from nothing. An earlier build
# fell back to API_PUBLIC_URL when this was unset, and a leftover
# API_PUBLIC_URL=http://localhost:3000 on the NAS sent Twitch's OAuth back to a
# server that does not exist. The page now refuses the button and names the
# problem instead of leaving it to surface after the consent screen.
CONNECT_REDIRECT_BASE=https://api.brittico.xyz
# The Twitch app for this flow, separate from the bot's. See above.
CONNECT_TWITCH_CLIENT_ID=
CONNECT_TWITCH_CLIENT_SECRET=
# The Kick app for this flow, separate from the bot's. See above.
CONNECT_KICK_CLIENT_ID=
CONNECT_KICK_CLIENT_SECRET=
# The Google app, for YouTube. Deliberately separate from AUTH_GOOGLE_* above:
# that one is site login (identity), this one reads the live chat and members.
# It can be the same Google Cloud client — repeat the values and register both
# redirect URIs there.
CONNECT_GOOGLE_CLIENT_ID=
CONNECT_GOOGLE_CLIENT_SECRET=
# The Spotify app, for the playlists on /musica/. The only connection here that
# lights no alert: it exists so the bot can create and maintain the week, month,
# discoveries and all-time playlists on the channel's account. Scopes:
# playlist-modify-public, playlist-modify-private, ugc-image-upload (the
# generated cover). https://developer.spotify.com/dashboard
#
# Two accounts, and the split saves a subscription: since February 2026 Spotify
# requires Premium on the account that REGISTERS the app, and only there. The
# authorising account can be free — and the playlists are created on the
# account that authorises. So: app on the Premium account, authorisation on the
# channel's. Development Mode also caps authorised users at five, added by hand
# under "User Management"; the channel's account has to be on that list before
# it can consent.
#
# Everything on the page works before this is filled in — the lists are built,
# stored and drawn, and the covers are generated. What is missing without it is
# the link that opens the playlist on Spotify.
CONNECT_SPOTIFY_CLIENT_ID=
CONNECT_SPOTIFY_CLIENT_SECRET=
# The Spotify account id allowed to connect, once it exists. The other three
# lock onto the channel's account because connecting the wrong one authorises
# nothing useful; here the risk is the mirror image — the browser is usually
# logged into a personal account, and that is where the channel's playlists
# would appear. Empty accepts any account and records which one it was.
SPOTIFY_ACCOUNT_ID=
