# tia-dash: copy to `.env` on the NAS and fill in. The `.env` never enters git.

# Image tag. Never `latest`. scripts/deploy.sh rewrites this line.
TIA_DASH_VERSION=0.1.0

# Where the SQLite database lives. It is the only state; Litestream replicates it to R2.
# The directory must belong to uid 1000 (the `node` user in the image): scripts/deploy.sh does it.
TIA_DASH_DATA_HOST_PATH=/mnt/StorageHD1/configs/tia_dash/data

# ===== Login (Cloudflare Access) =====
# Zero Trust > Settings > Custom Pages: the team domain, "<name>.cloudflareaccess.com".
CF_ACCESS_TEAM_DOMAIN=
# Zero Trust > Access > Applications > this app > Overview: "Application Audience (AUD) Tag".
CF_ACCESS_AUD=
# Comma separated. A second lock on top of the Access policy: only these emails get in.
ADMIN_EMAILS=

# ===== Ordering site (tiairannice.com/cardapio) =====
# The ordering site is part of the main website (Cloudflare Pages, see scripts/publish-shop.mjs) and talks to this
# server through api.tiairannice.com. Origins allowed to call /public/* from a browser (comma separated).
# scripts/deploy.sh adds this line to an existing .env when it is missing.
SHOP_ORIGINS=https://tiairannice.com,https://www.tiairannice.com
# This server's own public address. Photos uploaded in the dash are served from it (/public/img/<id>.webp), and the
# website lives on another origin, so the menu needs the full address. scripts/deploy.sh adds it when missing.
PUBLIC_API_URL=https://api.tiairannice.com
# Optional: hostnames on which THIS container serves the ordering site itself (a preview/staging copy). Empty in
# production: the site lives in the website, so no hostname is needed.
SHOP_HOSTS=
# Bot and fraud protection (Cloudflare Turnstile, invisible for almost everyone): the shop asks for a challenge when creating an
# order and on EVERY attempt to pay (someone trying many stolen cards on the shop). Create the widget in the Cloudflare dashboard
# (Turnstile > Add widget, hostname tiairannice.com), then put BOTH keys here; the config refuses to start with only one of them.
# The site key is public: the shop reads it from /public/store, so there is no need to publish the shop again to change it.
# Empty = no challenge (development).
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=

# ===== Payments and delivery price (all optional; the default works with no account) =====
# PAYMENTS_PROVIDER: manual (default: static Pix key set in the dash, the staff confirms by hand) or mercadopago.
# There is also "fake" (a simulated Mercado Pago) but the server REFUSES it in production.
# To turn Mercado Pago on, set all four. Secrets stay here, never in git. Do not print this file.
#PAYMENTS_PROVIDER=mercadopago
#MERCADOPAGO_ACCESS_TOKEN=
# Mercado Pago > Your integrations > Webhooks > the secret key shown after saving the notification URL
# (https://api.tiairannice.com/public/webhooks/mercadopago, topic "Payments").
#MERCADOPAGO_WEBHOOK_SECRET=
# Pay INSIDE the shop (Mercado Pago Payment Brick): card and Pix without leaving the page. Needs the public key (it goes
# to the browser, which turns the card into a token; the card number never reaches this server). The site's CSP must allow the
# Mercado Pago domains: publish it with `scripts/publish-shop.mjs --mercadopago-brick`.
#PAYMENTS_EMBEDDED=true
#MERCADOPAGO_PUBLIC_KEY=
# Where the customer comes back after paying (the ordering page). Default: first SHOP_ORIGINS + /cardapio.
#SHOP_RETURN_URL=https://tiairannice.com/cardapio
# Optional: max card installments (default 1, pay in full) and what shows on the card statement (22 chars).
#MP_MAX_INSTALLMENTS=1
#MP_STATEMENT_DESCRIPTOR=TIAIRANNICE
# 3-D Secure on cards: "optional" (default: Mercado Pago decides when the bank asks the customer to confirm in the bank app)
# or "off" (card is approved or refused, no challenge). Only matters with PAYMENTS_EMBEDDED=true.
#MP_3DS=optional
# DELIVERY_PROVIDER: manual (default: fee per neighborhood, the courier is called in the Uber app by hand), "uber" (Uber Direct: the price at
# checkout is the Uber quote for the customer's address, the delivery is the whole of Teresina, and the dash calls the courier) or "fake"
# (simulated courier, refused in production). "uber" needs the three credentials below or the server refuses to start. A call to the courier
# is a REAL ride and is charged to the store's card on the Uber account.
#DELIVERY_PROVIDER=manual
# Uber Direct (direct.uber.com > Developer): Customer ID, Client ID and Client Secret (secret: never in git, never printed).
#UBER_CUSTOMER_ID=
#UBER_CLIENT_ID=
#UBER_CLIENT_SECRET=
# false when these are TEST credentials (the dash then says "test mode"; the Uber sandbox sends no real courier). Default true.
#UBER_LIVE=true
# Developer > Webhooks > the webhook's "signing key", after registering https://api.tiairannice.com/public/webhooks/uber (delivery status
# and courier update). Without it the address does not exist and the dash only learns by asking Uber every minute and a half.
#UBER_WEBHOOK_KEY=

# ===== Marketing: Meta Conversions API (optional) =====
# When a site order is PAID, the server tells Meta about the purchase (the Pixel in the browser sends the same event, with the same
# id, and Meta counts one). The Pixel ID is NOT here: it is set in the dash (Marketing > Tracking). Only the access token is secret.
# Events Manager > your Pixel > Settings > Conversions API > Generate access token. Without it nothing is sent.
#META_CAPI_TOKEN=
# "Test events" code from Events Manager: events show up there without counting in the stats. Remove it when done testing.
#META_TEST_EVENT_CODE=
# Rarely needed: Graph API version (default v21.0) and base URL (default https://graph.facebook.com; https only in production).
#META_API_VERSION=v21.0
#META_GRAPH_URL=https://graph.facebook.com

# ===== Backup (Litestream -> Cloudflare R2) =====
# An R2 API token scoped to ONE bucket (Object Read & Write), same shape as the overlay reserve's.
# The bucket is created by hand: a scoped token cannot create buckets.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
